            "prompt_token_num": 5,
            "weight_decay": 0.0005,
            "min_lr": 0
        },
        {
            "model_name": "aper_adapter",
            "prefix": "exp_adapter",
            "convnet_type": "pretrained_vit_b16_224_in21k_adapter",
            "prompt_token_num": 30,
            "ffn_num": 64,
            "weight_decay": 0.005,
            "min_lr": 0
        },
        {
            "model_name": "aper_ssf",
            "prefix": "exp_ssf",
            "convnet_type": "pretrained_vit_b16_224_in21k_ssf",
            "prompt_token_num": 30,
            "ffn_num": 64,
            "weight_decay": 0.0005,
            "min_lr": 0
        }
    ]
