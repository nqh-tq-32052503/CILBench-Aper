{
    "scenario_name": "imagenetr_10tasks_20cls",
    "dataset": "imagenetr",
    "shuffle": true,
    "init_cls": 20,
    "increment": 20,
    "memory_size": 2000,
    "memory_per_class": 20,
    "fixed_memory": false,
    "device": [
        "0"
    ],
    "seed": [
        0,
        1,
        2
    ],
    "models": [
        {
            "model_name": "aper_finetune",
            "prefix": "exp_finetune",
            "convnet_type": "pretrained_vit_b16_224_in21k",
